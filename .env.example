# Storage (all paths are configurable)
TRACKCODER_DATA_DIR=~/TrackCoder
# TRACKCODER_WORKBOOK=~/TrackCoder/trackcoder.xlsx
TRACKME_PROGRESS_FILE=~/bin/TrackMe/daily-progress-tracker.json.b64
TRACKCODER_SCREENSHOT_DIR=~/TrackCoder/screenshots
TRACKCODER_BACKUPS=true

# Browser automation
TRACKCODER_HEADLESS=true
TRACKCODER_BROWSER_TIMEOUT=20
# CHROME_BINARY=/usr/bin/chromium
# CHROME_DRIVER_PATH=/usr/bin/chromedriver

# MonkeyType (required only when collecting WPM)
userEmail_monkey=your_email@example.com
password_monkey=replace_me

# Software.com (required only when collecting code time/screenshots)
userEmail_code_time=your_email@example.com
password_code_time=replace_me

# Goals: durations accept HH:MM or values such as 2h / 120m
TRACKCODER_DAILY_FOCUS_GOAL=02:00
TRACKCODER_WEEKLY_CODE_GOAL=10:00
TRACKCODER_WEEKLY_LINES_GOAL=500

# Optional Google Sheets sync (issue #12)
# Share the spreadsheet with the service account's client_email as an Editor.
# GOOGLE_SHEET_ID=your_spreadsheet_id
# GOOGLE_SHEETS_CREDENTIALS_FILE=~/TrackCoder/service-account.json
# GOOGLE_SHEETS_WORKSHEET=Track Coder
